# Copy to .env to override. Every value here is also the built-in default in
# docker-compose.yml, so the sandbox runs with no .env at all.
#
# This is a disposable local sandbox bound to 127.0.0.1. The credentials below
# are deliberately boring and must never be reused anywhere real.

# Manager login, for http://localhost:8014/manager/ and :8035/manager/
EVO_ADMIN=admin
EVO_ADMIN_EMAIL=admin@example.invalid
EVO_ADMIN_PASSWORD=ntgoc-sandbox

# Database
DB_USER=ntgoc
DB_PASSWORD=ntgoc
DB_ROOT_PASSWORD=ntgoc-root
DB_PREFIX=evo_

# Host ports
PORT_EVO14=8014
PORT_EVO35=8035

# Set to n to keep install/ after installation. Default y, matching a real
# deployment; n is useful only when debugging a failing install.
EVO_REMOVE_INSTALL=y
